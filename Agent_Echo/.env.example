# API keys only. This example is not automatically loaded.
# Copy to .env only if .env does not already exist; never overwrite existing keys.
# Private endpoints/deployments and other settings: connections.private.json (local copy of connections.json).
# Key values can also come from the process environment (environment wins over .env).
# Never commit real keys.

# Primary final provider: the group-assigned GW Azure resource.
GW_AZURE_OPENAI_KEY=

# Optional test providers.
GOOGLE_API_KEY=
OPENAI_API_KEY=
# Shared by the Nemotron and GLM profiles hosted by NVIDIA.
NVIDIA_API_KEY=
OPENCODE_API_KEY=
APINEX_API_KEY=
